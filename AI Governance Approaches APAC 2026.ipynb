   "source": [
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9,9))\n",
    "\n",
    "apac_background.plot(\n",
    "    color='#f0f0f0',\n",
    "    edgecolor='white',\n",
    "    linewidth=0.5,\n",
    "    ax=ax\n",
    ")\n",
    "\n",
    "apac_map1[apac_map1['Pro-Innovation (Soft Law)'] == 1].plot(\n",
    "    color='#1a9850',\n",
    "    edgecolor='white',\n",
    "    linewidth=0.6,\n",
    "    ax=ax\n",
    ")\n",
    "\n",
    "apac_map1[apac_map1['Statutory (Risk-Based)'] == 1].plot(\n",
    "    color='#d73027',\n",
    "    edgecolor='white',\n",
    "    linewidth=0.6,\n",
    "    ax=ax\n",
    ")\n",
    "\n",
    "apac_map1[apac_map1['Hybrid (Strategic)'] == 1].plot(\n",
    "    color='#4575b4',\n",
    "    edgecolor='white',\n",
    "    linewidth=0.6,\n",
    "    ax=ax\n",
    ")\n",
    "\n",
    "ax.set_xlim(60,180)\n",
    "ax.set_ylim(-50,60)\n",
    "\n",
    "ax.axis('off')\n",
    "\n",
    "legend_elements = [\n",
    "    mpatches.Patch(color='#1a9850', label='Pro-Innovation (Soft Law)'),\n",
    "    mpatches.Patch(color='#d73027', label='Statutory (Risk-Based)'),\n",
    "    mpatches.Patch(color='#4575b4', label='Hybrid (Strategic)')\n",
    "]\n",
    "\n",
    "ax.legend(\n",
    "    handles=legend_elements,\n",
    "    loc='center left',\n",
    "    bbox_to_anchor=(1.02,0.6),\n",
    "    frameon=False,\n",
    "    fontsize=11\n",
    ")\n",
    "\n",
    "plt.show()"
   ]
