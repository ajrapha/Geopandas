   "source": [
    "The following classifications are based on this study: https://ai.gov.eg/SynchedFiles/en/Resources/Global%20AI%20Governance%20Frameworks%20A%20Comparative%20Study.pdf"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "0f71c8d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def classify(row):\n",
    "    if row['Pro-Innovation (Soft Law)'] == 1:\n",
    "        return 'Pro-Innovation (Soft Law)'\n",
    "    elif row['tatutory (Risk-Based)'] == 1:\n",
    "        return 'Statutory (Risk-Based)'\n",
    "    elif row['Hybrid (Strategic)'] == 1:\n",
    "        return 'Hybrid (Strategic)'\n",
    "\n",
    ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "26b9fc65",
   "metadata": {},
   "outputs": [],
   "source": [
    "world = gpd.read_file(\n",
    "    'https://naturalearth.s3.amazonaws.com/110m_cultural/ne_110m_admin_0_countries.zip'\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "bd79bba5",
   "metadata": {},
   "outputs": [],
   "source": [
    "apac_map1 = world.merge(\n",
    "    apac_regulatory,\n",
    "    left_on = 'ADMIN',\n",
    "    right_on = 'Country',\n",
    "    how = 'inner'\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "9a75c24e",
   "metadata": {},
   "outputs": [],
   "source": [
    "apac_bounds = (60, -50, 180, 60)\n",
    "\n",
    "apac_background = world.cx[\n",
    "    apac_bounds[0]:apac_bounds[2],\n",
    "    apac_bounds[1]:apac_bounds[3]\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "58c73a59",
   "metadata": {},
   "outputs": [
